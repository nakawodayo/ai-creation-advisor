{
    "compilerOptions": {
        "target": "ES6",
        "module": "ESNext",
        "outDir": "./dist",
        "rootDir": "./src/scripts",
        "strict": true,
        "esModuleInterop": true,
        "lib": ["ES6", "DOM"],
        "moduleResolution": "node",
        "resolveJsonModule": true
    },
    "include": ["src/scripts/**/*.ts"],
    "exclude": ["node_modules"]
}
